    {'start': start, 'stop': stop, 'restart': restart}[a.command](conf)


def cmd_logs(a):
    conf = load_conf()
    if conf['mode'] == 'native':
        cmd = ['journalctl', '-n', str(a.lines), '--no-pager', '-o', 'short-iso']
        for u in SERVICE_UNITS:
            cmd += ['-u', u]
        if a.follow:
            cmd.append('-f')
        os.execvp(cmd[0], cmd)
    elif conf['mode'] == 'podman':
        cmd = ['podman', 'logs', '--tail', str(a.lines), *(['-f'] if a.follow else []), PODMAN_NAME]
        os.execvp(cmd[0], cmd)
    else:
        cur = current_release(conf)
        cmd = [*compose_cmd(conf, cur), 'logs', '--tail', str(a.lines)] + (['-f'] if a.follow else [])
        os.environ['EZY_VERSION'] = version_of(cur) or 'local'
        os.execvp(cmd[0], cmd)


def cmd_password(a):
    conf = load_conf()
    require_root(conf)
    password = None
    if a.generate:
        alphabet = 'abcdefghjkmnpqrstuvwxyz23456789'
        raw = ''.join(secrets.choice(alphabet) for _ in range(16))
        password = '-'.join(raw[i:i + 4] for i in range(0, 16, 4))
    elif a.stdin:                               # from the Cockpit module: kept off the command line
        password = sys.stdin.readline().rstrip('\n')
    elif not a.json:
        import getpass
        password = getpass.getpass('New admin password: ')
        if getpass.getpass('Again: ') != password:
            raise Fail('They do not match; nothing was changed.')
    if not password or len(password) < 8:
        raise Fail('At least 8 characters; nothing was changed.')
    cur = current_release(conf)
    if conf['mode'] == 'native':
        run(['runuser', '-u', conf['user'], '--', 'env', f'EZY_STATE={conf["state"]}',
             str(cur / '.venv/bin/python'), 'docker/init.py', 'password'],
            cwd=str(cur), capture=True, env={'EZY_ADMIN_PASSWORD': password})
    elif conf['mode'] == 'podman':
        run(['podman', 'exec', '-e', 'EZY_ADMIN_PASSWORD', PODMAN_NAME, 'ezyspeech', 'password'],
            capture=True, env={'EZY_ADMIN_PASSWORD': password})
    else:
        compose(conf, 'exec', '-T', 'ezyspeech', 'ezyspeech', 'password', password, capture=True)
    restart(conf)
    if a.json:
        print(json.dumps({'password': password if a.generate else None}))
    else:
        print('Admin password set' + (f': {password}' if a.generate else '') + '. The servers restarted.')


def cmd_backup(a):
    conf = load_conf()
    require_root(conf)
    dest = Path(a.file or f'ezyspeech-backup-{time.strftime("%Y%m%d-%H%M%S")}.tar.gz').resolve()
    if conf['mode'] == 'native':
        run(['tar', 'czf', str(dest), '-C', conf['state'], '.'])
    elif conf['mode'] == 'podman':
        with open(dest, 'wb') as out:
            podman_run(conf, version_of(current_release(conf)), 'czf', '-', '-C', '/var/lib/ezyspeech', '.',
                       entrypoint='tar', stdout=out)
    else:
        with open(dest, 'wb') as out:
            cur = current_release(conf)
            subprocess.run([*compose_cmd(conf, cur), 'run', '--rm', '--no-deps', '--entrypoint', 'tar',
                            'ezyspeech', 'czf', '-', '-C', '/var/lib/ezyspeech', '.'],
                           stdout=out, check=True, env={**os.environ, 'EZY_VERSION': version_of(cur)})
    print(f'Saved {dest}')


def cmd_uninstall(a):
    conf = load_conf()
    require_root(conf)
    if not a.yes and sys.stdin.isatty():
        what = ' and DELETE its settings, secrets and transcripts' if a.purge else ''
        if input(f'Uninstall EzySpeech{what}? [y/N] ').strip().lower() not in ('y', 'yes'):
            return
    if conf['mode'] == 'native':
        systemctl('disable', '--now', *SERVICE_UNITS, check=False)
        for u in SERVICE_UNITS:
            unit = Path('/etc/systemd/system', u)
            if unit.exists():
                unit.unlink()
        systemctl('daemon-reload', check=False)
        if a.purge:
            shutil.rmtree(conf['state'], ignore_errors=True)
            run(['userdel', conf['user']], check=False, quiet=True)
    elif conf['mode'] == 'podman':
        systemctl('stop', PODMAN_UNIT, check=False)
        if QUADLET.exists():
            QUADLET.unlink()
        systemctl('daemon-reload', check=False)
        run(['podman', 'rm', '-f', PODMAN_NAME], check=False, quiet=True)
        for r in releases(conf):
            run(['podman', 'image', 'rm', podman_image(r.name)], check=False, quiet=True)
        if a.purge:
            run(['podman', 'volume', 'rm', PODMAN_NAME], check=False, quiet=True)
    else:
        compose(conf, 'down', *(['-v'] if a.purge else []), check=False)
        for r in releases(conf):
            run(['docker', 'image', 'rm', f'ezyspeech:{r.name}'], check=False, quiet=True)
    shutil.rmtree(conf['home'], ignore_errors=True)
    for link in (Path('/usr/local/bin/ezyspeech'), Path('/usr/bin/ezyspeech'),
                 Path.home() / '.local/bin/ezyspeech'):
        if link.is_symlink():
            link.unlink()
    Path(conf['_path']).unlink()
    print('EzySpeech is uninstalled.' + ('' if a.purge else
          ' Its settings and transcripts were kept' + (
              f' in {conf["state"]}.' if conf['mode'] == 'native'
              else f' in the Podman volume {PODMAN_NAME}.' if conf['mode'] == 'podman'
              else ' in the Docker volume ezyspeech_ezyspeech.')))


def cmd_menu(a):
    conf = load_conf()
    script = current_release(conf) / 'install.sh'
    os.execvp('bash', ['bash', str(script), '--manage'])


def main(argv):
    p = argparse.ArgumentParser(prog='ezyspeech', description='Install, update and run EzySpeech.')
    sub = p.add_subparsers(dest='command', required=True)
    s = sub.add_parser('status'); s.add_argument('--json', action='store_true'); s.set_defaults(func=cmd_status)
    sub.add_parser('version').set_defaults(func=cmd_version)
