def cmd_install(a):
    mode = a.mode
    system = platform.system()
    if mode == 'native' and (system != 'Linux' or not shutil.which('systemctl')):
        raise Fail('A native install needs Linux with systemd. Use --mode docker here.')
    if mode in ('native', 'podman'):
        require_root()
    as_root = os.geteuid() == 0
    home = Path(a.home or ('/opt/ezyspeech' if as_root else Path.home() / 'ezyspeech'))
    conf_path = Path('/etc/ezyspeech/install.conf') if as_root else CONF_PATHS[-1]
    existing = load_conf(required=False)
    if existing and not a.force:
        raise Fail(f'EzySpeech is already installed ({existing["_path"]}). '
                   'Use ezyspeech update, or uninstall first.')
    conf = {'mode': mode, 'home': str(home), 'repo': REPO,
            'port': str(a.port), 'admin_port': str(a.admin_port)}
    if mode == 'native':
        conf.update(state=a.state or '/var/lib/ezyspeech', user=a.user or 'ezyspeech')

    source = Path(a.source).resolve()
    version = version_of(source) if source.is_dir() else None
    if not version:
        with tempfile.TemporaryDirectory() as t:
            root = extract(source, t)
            version = version_of(root)
    if not version:
        raise Fail('The source has no VERSION file.')

    Out.step(5, f'Installing EzySpeech {version} ({mode})')
    home.mkdir(parents=True, exist_ok=True)
    env = {'EZY_PORT': str(a.port), 'EZY_ADMIN_PORT': str(a.admin_port),
           'EZY_HTTPS': a.https or None, 'EZY_HOSTNAMES': a.hostnames or None,
           'EZY_EXTERNAL_URL': a.external_url or None,
           'EZY_ADMIN_PASSWORD': os.environ.get('EZY_ADMIN_PASSWORD') or None,
           'TZ': a.tz or None}

    if mode == 'native':
        Out.step(10, 'Packages Python needs')
        ensure_native_packages()
        Out.step(15, f'Service account {conf["user"]}')
        if run(['id', '-u', conf['user']], check=False, capture=True).returncode != 0:
            run(['useradd', '--system', '--home-dir', conf['state'], '--no-create-home',
                 '--shell', '/usr/sbin/nologin', conf['user']])
        state = Path(conf['state'])
        for sub in set(STATE_LINKS.values()):
            (state / sub).mkdir(parents=True, exist_ok=True)
        if a.migrate_from:
            Out.step(18, f'Bringing over settings and transcripts from {a.migrate_from}')
            migrate_old_native(Path(a.migrate_from), state)
        run(['chown', '-R', f'{conf["user"]}:{conf["user"]}', str(state)])
        run(['chmod', '750', str(state)])
        if shutil.which('restorecon'):          # SELinux: copies keep their old labels
            run(['restorecon', '-R', str(state)], check=False, quiet=True)
        Out.step(20, 'Preparing the release')
        release = stage_release(conf, source, version)
        link_current(conf, release)
        Out.step(70, 'First-run setup')
        printed = run_init(conf, release, env)
        Out.step(80, 'System services')
        for unit, body in native_units(conf).items():
            Path('/etc/systemd/system', unit).write_text(body)
        systemctl('daemon-reload')
        if a.migrate_from:
            systemctl('stop', *SERVICE_UNITS, check=False)
        systemctl('enable', '--now', *SERVICE_UNITS)
    elif mode == 'podman':
        if not shutil.which('podman') or not shutil.which('systemctl'):
            raise Fail('Podman is not installed. On Fedora, RHEL, AlmaLinux or Rocky: dnf install podman')
        if (podman_version() or (0,)) < (4, 4, 0):
            raise Fail('Podman 4.4 or later is needed: it runs EzySpeech as a system service through Quadlet.')
        Out.step(15, 'Unpacking the release')
        release = stage_release(conf, source, version)
        link_current(conf, release)
        set_docker_env(conf, {k: v for k, v in env.items() if k != 'EZY_ADMIN_PASSWORD' and v})
        Out.step(25, 'Building the image (a minute or two)')
        podman_build(release, version)
        Out.step(70, 'First-run setup')
        printed = run_init(conf, release, env)
        Out.step(80, 'System service')
        write_quadlet(conf, version)
        systemctl('start', PODMAN_UNIT)
    else:
        if not shutil.which('docker') or run(['docker', 'info'], check=False, quiet=True).returncode:
            raise Fail('Docker is not installed or not running.')
        Out.step(15, 'Unpacking the release')
        release = stage_release(conf, source, version)
        link_current(conf, release)
        set_docker_env(conf, {k: v for k, v in env.items() if k != 'EZY_ADMIN_PASSWORD' and v})
        Out.step(25, 'Building the image (a minute or two)')
        compose(conf, 'build', release=release)
        Out.step(70, 'First-run setup')
        printed = run_init(conf, release, env)
        Out.step(80, 'Starting')
        compose(conf, 'up', '-d', '--remove-orphans', release=release)

    save_conf(conf, conf_path)
    link_command(conf, release)
    Out.step(90, 'Waiting for it to come up')
    if not wait_healthy(conf, version):
        raise Fail('It was installed but did not come up healthy. See: ezyspeech logs')
    if a.cockpit:
        Out.step(95, 'Cockpit module')
        install_cockpit(a.cockpit)
    Out.step(100, 'Done')
    password = re.search(r'Password:\s+(\S+)', printed or '')
    found = settings(conf)
    result = {'version': version, 'mode': mode, 'home': str(home), 'ports': list(ports(conf)),
              'password': password.group(1) if password else None,
              'username': found.get('authentication.admin_username') or 'admin',
              'https': found.get('admin_server.use_https') == 'true',
              'external_url': found.get('server.external_url') or None}
    print('RESULT ' + json.dumps(result), flush=True)


def ensure_native_packages():
    try:
        import venv  # noqa: F401
        import ensurepip  # noqa: F401
        return
    except ImportError:
        pass
    if shutil.which('apt-get'):
        run(['apt-get', 'update', '-qq'], quiet=True)
        run(['apt-get', 'install', '-y', '-qq', 'python3-venv', 'python3-pip'], quiet=True)
    elif shutil.which('dnf'):
        run(['dnf', 'install', '-y', '-q', 'python3', 'python3-pip'], quiet=True)
    else:
        raise Fail("Python's venv module is missing; install it (python3-venv) and run this again.")


def migrate_old_native(old, state):
    """An install made by ezy_manager.py kept its settings inside the code."""
    for rel, sub in (('config', 'config'), ('data', 'data'), ('exports', 'exports'),
                     ('app/static/oem', 'oem')):
        src = old / rel
        if src.is_dir():
            for item in src.iterdir():
                dest = state / sub / item.name
                if not dest.exists():
                    (shutil.copytree if item.is_dir() else shutil.copy2)(item, dest)


def link_command(conf, release):
    """Put this command on the PATH, pointing at the release in use."""
    target = home_of(conf) / 'current' / 'ops' / 'ezyspeech'
    for bindir in ('/usr/local/bin', str(Path.home() / '.local/bin')):
        try:
            Path(bindir).mkdir(parents=True, exist_ok=True)
            link = Path(bindir) / 'ezyspeech'
            if link.is_symlink() or link.exists():
                link.unlink()
            link.symlink_to(target)
            break
        except OSError:
            continue
    # sudo on Red Hat-like systems runs commands with a PATH (secure_path)
    # that leaves out /usr/local/bin, and so does Cockpit's administrative
    # access; a link in /usr/bin is found either way.
    if os.geteuid() == 0:
        link = Path('/usr/bin/ezyspeech')
        if link.is_symlink() or not link.exists():
            if link.is_symlink():
                link.unlink()
            link.symlink_to(target)


def install_cockpit(source):
    """The Cockpit module: a package file, or a URL to one."""
    dest = COCKPIT_DIR
    with tempfile.TemporaryDirectory() as t:
        pkg = Path(source)
        if not pkg.exists():
            pkg = Path(t) / 'cockpit.tar.gz'
            download(source, pkg)
        root = extract(pkg, Path(t) / 'x')
        if not (root / 'manifest.json').exists():
            raise Fail('The Cockpit package has no manifest.json.')
        shutil.rmtree(dest, ignore_errors=True)
        shutil.copytree(root, dest)
        run(['chmod', '-R', 'a+rX', str(dest)])
    # The old module's "make install" put it in /usr/local/share, which Cockpit
    # reads before /usr/share, so it would hide this one. One linked into a
    # home directory hides it for that person only; say so, but leave it.
    for old in ('ezyspeech', 'ezy-speech-cockpit'):
        p = Path('/usr/local/share/cockpit') / old
        if p.is_symlink() or p.is_file():
            p.unlink()
        elif p.exists():
            shutil.rmtree(p, ignore_errors=True)
    for p in sorted(Path('/home').glob('*/.local/share/cockpit/*')) + \
            sorted(Path('/root/.local/share/cockpit').glob('*')):
        if p.name in ('ezyspeech', 'ezy-speech-cockpit'):
            Out.info(f'Note: {p} is an older copy of the Cockpit module; '
                    f'remove it to see this one when signed in as that user.')


def cmd_status(a):
    conf = load_conf()
    cur = current_release(conf)
    data = {'mode': conf['mode'], 'home': conf['home'], 'version': version_of(cur) if cur else None,
            'releases': [r.name for r in releases(conf)], 'health': health(conf)}
    found = settings(conf)
    data['addresses'] = {'listener': found.get('server.external_url') or None,
                         'console': found.get('admin_server.external_url') or None,
                         'https': found.get('server.use_https') == 'true',
                         'console_https': found.get('admin_server.use_https') == 'true'}
    if conf['mode'] == 'native':
        data['services'] = services_state()
        data['state'] = conf['state']
    elif conf['mode'] == 'podman':
        r = run(['podman', 'ps', '-a', '--filter', f'name=^{PODMAN_NAME}$', '--format', 'json'],
                capture=True, check=False)
        rows = json.loads(r.stdout or '[]') if r.returncode == 0 else []
        data['containers'] = {PODMAN_NAME: (rows[0].get('State') if rows else 'missing')}
    else:
        r = compose(conf, 'ps', '--format', 'json', capture=True, check=False)
        rows = []
        for line in (r.stdout or '').splitlines():
            line = line.strip()
            if line.startswith('{'):
                rows.append(json.loads(line))
            elif line.startswith('['):
                rows.extend(json.loads(line))
        data['containers'] = {row.get('Service', row.get('Name')): row.get('State') for row in rows}
    data['running'] = bool(data['health']['listener'] and data['health']['console'])
    data['usage'] = usage(conf)
    if a.json:
        print(json.dumps(data))
        return
    h = data['health']
    print(f"EzySpeech {data['version']} ({conf['mode']}) in {conf['home']}")
    print(f"  listener page  port {h['port']}: {'up' if h['listener'] else 'DOWN'}"
          + (f", {h['listeners']} listening" if h.get('listeners') is not None else ''))
    print(f"  console        port {h['admin_port']}: {'up' if h['console'] else 'DOWN'}")
    print(f"  releases kept: {', '.join(data['releases'])}")


def cmd_version(a):
    conf = load_conf()
    print(version_of(current_release(conf)) or 'unknown')


def cmd_check(a):
    conf = load_conf()
    installed = version_of(current_release(conf))
    rel = fetch_release()
    newer = vtuple(rel['version']) > vtuple(installed or '0')
    out = {'installed': installed, 'latest': rel['version'], 'update_available': newer,
           'notes': rel['notes'], 'url': rel['url']}
    if a.json:
        print(json.dumps(out))
    else:
        print(f'Installed {installed}; latest release {rel["version"]}.')
        print('An update is available: sudo ezyspeech update' if newer else 'Up to date.')


def cmd_update(a):
    conf = load_conf()
    require_root(conf)
    before = current_release(conf)
    installed = version_of(before)
    rel = fetch_release(a.to)
    if not a.to and vtuple(rel['version']) <= vtuple(installed or '0') and not a.force:
        Out.info(f'Already up to date ({installed}).')
        return
    if not a.yes and sys.stdin.isatty():
        if input(f'Update EzySpeech {installed} -> {rel["version"]}? [y/N] ').strip().lower() not in ('y', 'yes'):
            return
    Out.step(5, f'Downloading {rel["version"]}')
    with tempfile.TemporaryDirectory() as t:
        pkg = verified_download(rel, t)
        Out.step(15, 'Checked against its SHA-256; preparing it')
        release = stage_release(conf, pkg, rel['version'])
    if conf['mode'] == 'docker':
        Out.step(50, 'Building its image')
        compose(conf, 'build', release=release)
    elif conf['mode'] == 'podman':
        Out.step(50, 'Building its image')
        podman_build(release, rel['version'])
    Out.step(70, 'Bringing the settings up to date')
    run_init(conf, release, {})
    Out.step(80, f'Switching to {rel["version"]}')
    link_current(conf, release)
    restart(conf)
    Out.step(90, 'Checking it came up')
    if not wait_healthy(conf, rel['version']):
        Out.info(f'{rel["version"]} did not come up healthy; going back to {installed}.')
        link_current(conf, before)
        restart(conf)
        wait_healthy(conf, installed)
        raise Fail(f'Update to {rel["version"]} failed and was rolled back to {installed}. '
                   'Its log: ezyspeech logs')
    prune(conf)
    Out.step(95, 'Finishing')
    # The rest is done by the new release's own copy of this command, so a
    # change to it takes effect on the update that brings it.
    if run([sys.executable, str(release / 'ops' / 'ezyspeech'), 'finish-update'],
           check=False).returncode:
        Out.info('Finishing the update went wrong; it can be retried: ezyspeech finish-update')
    Out.step(100, f'Updated to {rel["version"]}')


def cmd_finish_update(a):
    """After an update: the command on the PATH, and the Cockpit module."""
    conf = load_conf()
    require_root(conf)
    cur = current_release(conf)
    link_command(conf, cur)
    if COCKPIT_DIR.exists():
        try:
            rel = fetch_release(version_of(cur))
            if rel.get('cockpit'):
                with tempfile.TemporaryDirectory() as t:
                    install_cockpit(str(verified_download(rel, t, 'cockpit')))
        except Exception as exc:                # the update itself went through
            Out.info(f'The Cockpit module was not updated: {exc}')


def cmd_rollback(a):
    conf = load_conf()
    require_root(conf)
    cur = current_release(conf)
    older = [r for r in releases(conf) if vtuple(r.name) < vtuple(cur.name)]
    if not older:
        raise Fail('There is no earlier release kept to go back to.')
    target = older[-1]
    link_current(conf, target)
    restart(conf)
    if not wait_healthy(conf, version_of(target)):
        raise Fail(f'{target.name} did not come up healthy either. See: ezyspeech logs')
    link_command(conf, target)
    Out.info(f'Back on {target.name}.')


def cmd_service(a):
