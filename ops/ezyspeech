def cmd_install(a):
    mode = a.mode
    system = platform.system()
    if mode == 'native' and (system != 'Linux' or not shutil.which('systemctl')):
        raise Fail('A native install needs Linux with systemd. Use --mode docker here.')
    if mode in ('native', 'podman'):
        require_root()
    as_root = os.geteuid() == 0
    home = Path(a.home or ('/opt/ezyspeech' if as_root else Path.home() / 'ezyspeech'))
    conf_path = Path('/etc/ezyspeech/install.conf') if as_root else CONF_PATHS[-1]
    existing = load_conf(required=False)
    if existing and not a.force:
        raise Fail(f'EzySpeech is already installed ({existing["_path"]}). '
                   'Use ezyspeech update, or uninstall first.')
    conf = {'mode': mode, 'home': str(home), 'repo': REPO,
            'port': str(a.port), 'admin_port': str(a.admin_port)}
    if mode == 'native':
        conf.update(state=a.state or '/var/lib/ezyspeech', user=a.user or 'ezyspeech')

    source = Path(a.source).resolve()
    version = version_of(source) if source.is_dir() else None
    if not version:
        with tempfile.TemporaryDirectory() as t:
            root = extract(source, t)
            version = version_of(root)
    if not version:
        raise Fail('The source has no VERSION file.')

    Out.step(5, f'Installing EzySpeech {version} ({mode})')
    home.mkdir(parents=True, exist_ok=True)
    env = {'EZY_PORT': str(a.port), 'EZY_ADMIN_PORT': str(a.admin_port),
           'EZY_HTTPS': a.https or None, 'EZY_HOSTNAMES': a.hostnames or None,
           'EZY_EXTERNAL_URL': a.external_url or None,
           'EZY_ADMIN_PASSWORD': os.environ.get('EZY_ADMIN_PASSWORD') or None,
           'EZY_TRANSLATION_PROVIDERS': os.environ.get('EZY_TRANSLATION_PROVIDERS') or None,
           'TZ': a.tz or None}

    if mode == 'native':
        Out.step(10, 'Packages Python needs')
        ensure_native_packages()
        Out.step(15, f'Service account {conf["user"]}')
        if run(['id', '-u', conf['user']], check=False, capture=True).returncode != 0:
            run(['useradd', '--system', '--home-dir', conf['state'], '--no-create-home',
                 '--shell', '/usr/sbin/nologin', conf['user']])
        state = Path(conf['state'])
        for sub in set(STATE_LINKS.values()):
            (state / sub).mkdir(parents=True, exist_ok=True)
        if a.migrate_from:
            Out.step(18, f'Bringing over settings and transcripts from {a.migrate_from}')
            migrate_old_native(Path(a.migrate_from), state)
        run(['chown', '-R', f'{conf["user"]}:{conf["user"]}', str(state)])
        run(['chmod', '750', str(state)])
        if shutil.which('restorecon'):          # SELinux: copies keep their old labels
            run(['restorecon', '-R', str(state)], check=False, quiet=True)
        Out.step(20, 'Preparing the release')
        release = stage_release(conf, source, version)
        link_current(conf, release)
        Out.step(70, 'First-run setup')
        printed = run_init(conf, release, env)
        Out.step(80, 'System services')
        for unit, body in native_units(conf).items():
            Path('/etc/systemd/system', unit).write_text(body)
        systemctl('daemon-reload')
        if a.migrate_from:
            systemctl('stop', *SERVICE_UNITS, check=False)
        systemctl('enable', '--now', *SERVICE_UNITS)
    elif mode == 'podman':
        if not shutil.which('podman') or not shutil.which('systemctl'):
            raise Fail('Podman is not installed. On Fedora, RHEL, AlmaLinux or Rocky: dnf install podman')
        if (podman_version() or (0,)) < (4, 4, 0):
            raise Fail('Podman 4.4 or later is needed: it runs EzySpeech as a system service through Quadlet.')
        Out.step(15, 'Unpacking the release')
        release = stage_release(conf, source, version)
        link_current(conf, release)
        set_docker_env(conf, {k: v for k, v in env.items() if k not in ONCE_ONLY and v})
        Out.step(25, 'Building the image (a minute or two)')
        podman_build(release, version)
        Out.step(70, 'First-run setup')
        printed = run_init(conf, release, env)
        Out.step(80, 'System service')
        write_quadlet(conf, version)
        systemctl('start', PODMAN_UNIT)
    else:
        if not shutil.which('docker') or run(['docker', 'info'], check=False, quiet=True).returncode:
            raise Fail('Docker is not installed or not running.')
        Out.step(15, 'Unpacking the release')
        release = stage_release(conf, source, version)
        link_current(conf, release)
        set_docker_env(conf, {k: v for k, v in env.items() if k not in ONCE_ONLY and v})
        Out.step(25, 'Building the image (a minute or two)')
        compose(conf, 'build', release=release)
        Out.step(70, 'First-run setup')
        printed = run_init(conf, release, env)
        Out.step(80, 'Starting')
        compose(conf, 'up', '-d', '--remove-orphans', release=release)

    save_conf(conf, conf_path)
    conf['_path'] = str(conf_path)
    link_command(conf, release)
    if as_root and shutil.which('systemctl') and not a.no_auto_backup:
        Out.step(88, f'Backups every {AUTO_BACKUP_WHEN}, the newest {AUTO_BACKUP_KEEP} kept')
        set_auto_backup(conf, True)
    Out.step(90, 'Waiting for it to come up')
    if not wait_healthy(conf, version):
        raise Fail('It was installed but did not come up healthy. See: ezyspeech logs')
    if a.cockpit:
        Out.step(95, 'Cockpit module')
        install_cockpit(a.cockpit)
    Out.step(100, 'Done')
    password = re.search(r'Password:\s+(\S+)', printed or '')
    found = settings(conf)
    result = {'version': version, 'mode': mode, 'home': str(home), 'ports': list(ports(conf)),
              'password': password.group(1) if password else None,
              'username': found.get('authentication.admin_username') or 'admin',
              'https': found.get('admin_server.use_https') == 'true',
              'external_url': found.get('server.external_url') or None}
    print('RESULT ' + json.dumps(result), flush=True)


# The servers' dependencies (Flask, requests, cryptography, ...) have left
# Python 3.9 behind, and their fixed versions with it.
APP_PYTHON_MIN = (3, 10)


def _python_ok(exe):
    r = run([exe, '-c', 'import sys, venv, ensurepip; print("%d.%d" % sys.version_info[:2])'],
            check=False, capture=True)
    return r.returncode == 0 and vtuple(r.stdout.strip()) >= APP_PYTHON_MIN + (0,)


def app_python():
    """The Python the servers run on: 3.10 or later, with venv. This command
    may run on an older one (it needs only the standard library); the
    servers' environment is made with this."""
    candidates = [sys.executable] + [shutil.which(f'python3.{m}') for m in range(14, 9, -1)]
    for exe in filter(None, candidates):
        if _python_ok(exe):
            return exe
    raise Fail('The servers need Python 3.10 or later with venv; this machine has none. '
               'On RHEL, AlmaLinux or Rocky 9: dnf install python3.12')


def ensure_native_packages():
    """Python 3.10 or later with venv and pip, installed from the system's
    own packages when it is missing: RHEL 9 and its kin come with 3.9."""
    try:
        app_python()
        return
    except Fail:
        pass
    if shutil.which('dnf'):
        run(['dnf', 'install', '-y', '-q', 'python3.12', 'python3.12-pip'], quiet=True, check=False)
    elif shutil.which('apt-get'):
        run(['apt-get', 'update', '-qq'], quiet=True)
        run(['apt-get', 'install', '-y', '-qq', 'python3-venv', 'python3-pip'], quiet=True, check=False)
    app_python()                            # still none: says what to do


def migrate_old_native(old, state):
    """An install made by ezy_manager.py kept its settings inside the code."""
    for rel, sub in (('config', 'config'), ('data', 'data'), ('exports', 'exports'),
                     ('app/static/oem', 'oem')):
        src = old / rel
        if src.is_dir():
            for item in src.iterdir():
                dest = state / sub / item.name
                if not dest.exists():
                    (shutil.copytree if item.is_dir() else shutil.copy2)(item, dest)


def link_command(conf, release):
    """Put this command on the PATH, pointing at the release in use."""
    target = home_of(conf) / 'current' / 'ops' / 'ezyspeech'
    for bindir in ('/usr/local/bin', str(Path.home() / '.local/bin')):
        try:
            Path(bindir).mkdir(parents=True, exist_ok=True)
            link = Path(bindir) / 'ezyspeech'
            if link.is_symlink() or link.exists():
                link.unlink()
            link.symlink_to(target)
            break
        except OSError:
            continue
    # sudo on Red Hat-like systems runs commands with a PATH (secure_path)
    # that leaves out /usr/local/bin, and so does Cockpit's administrative
    # access; a link in /usr/bin is found either way.
    if os.geteuid() == 0:
        link = Path('/usr/bin/ezyspeech')
        if link.is_symlink() or not link.exists():
            if link.is_symlink():
                link.unlink()
            link.symlink_to(target)


def install_cockpit(source):
    """The Cockpit module: a package file, or a URL to one."""
    dest = COCKPIT_DIR
    with tempfile.TemporaryDirectory() as t:
        pkg = Path(source)
        if not pkg.exists():
            pkg = Path(t) / 'cockpit.tar.gz'
            download(source, pkg)
        root = extract(pkg, Path(t) / 'x')
        if not (root / 'manifest.json').exists():
            raise Fail('The Cockpit package has no manifest.json.')
        shutil.rmtree(dest, ignore_errors=True)
        shutil.copytree(root, dest)
        run(['chmod', '-R', 'a+rX', str(dest)])
    # The old module's "make install" put it in /usr/local/share, which Cockpit
    # reads before /usr/share, so it would hide this one. One linked into a
    # home directory hides it for that person only; say so, but leave it.
    for old in ('ezyspeech', 'ezy-speech-cockpit'):
        p = Path('/usr/local/share/cockpit') / old
        if p.is_symlink() or p.is_file():
            p.unlink()
        elif p.exists():
            shutil.rmtree(p, ignore_errors=True)
    for p in sorted(Path('/home').glob('*/.local/share/cockpit/*')) + \
            sorted(Path('/root/.local/share/cockpit').glob('*')):
        if p.name in ('ezyspeech', 'ezy-speech-cockpit'):
            Out.info(f'Note: {p} is an older copy of the Cockpit module; '
                    f'remove it to see this one when signed in as that user.')


def cmd_status(a):
    conf = load_conf()
    cur = current_release(conf)
    data = {'mode': conf['mode'], 'home': conf['home'], 'version': version_of(cur) if cur else None,
            'releases': [r.name for r in releases(conf)], 'health': health(conf)}
    target = rollback_target(conf)
    data['rollback_to'] = target.name if target else None
    found = settings(conf)
    data['addresses'] = {'listener': found.get('server.external_url') or None,
                         'console': found.get('admin_server.external_url') or None,
                         'https': found.get('server.use_https') == 'true',
                         'console_https': found.get('admin_server.use_https') == 'true'}
    if conf['mode'] == 'native':
        data['services'] = services_state()
        data['state'] = conf['state']
    elif conf['mode'] == 'podman':
        r = run(['podman', 'ps', '-a', '--filter', f'name=^{PODMAN_NAME}$', '--format', 'json'],
                capture=True, check=False)
        rows = json.loads(r.stdout or '[]') if r.returncode == 0 else []
        data['containers'] = {PODMAN_NAME: (rows[0].get('State') if rows else 'missing')}
    else:
        r = compose(conf, 'ps', '--format', 'json', capture=True, check=False)
        rows = []
        for line in (r.stdout or '').splitlines():
            line = line.strip()
            if line.startswith('{'):
                rows.append(json.loads(line))
            elif line.startswith('['):
                rows.extend(json.loads(line))
        data['containers'] = {row.get('Service', row.get('Name')): row.get('State') for row in rows}
    data['running'] = bool(data['health']['listener'] and data['health']['console'])
    data['usage'] = usage(conf)
    if a.json:
        print(json.dumps(data))
        return
    h = data['health']
    print(f"EzySpeech {data['version']} ({conf['mode']}) in {conf['home']}")
    print(f"  listener page  port {h['port']}: {'up' if h['listener'] else 'DOWN'}"
          + (f", {h['listeners']} listening" if h.get('listeners') is not None else ''))
    print(f"  console        port {h['admin_port']}: {'up' if h['console'] else 'DOWN'}")
    print(f"  releases kept: {', '.join(data['releases'])}")


def cmd_version(a):
    conf = load_conf()
    print(version_of(current_release(conf)) or 'unknown')


def cmd_check(a):
    conf = load_conf()
    installed = version_of(current_release(conf))
    rel = fetch_release()
    newer = vtuple(rel['version']) > vtuple(installed or '0')
    out = {'installed': installed, 'latest': rel['version'], 'update_available': newer,
           'notes': rel['notes'], 'url': rel['url']}
    if a.json:
        print(json.dumps(out))
    else:
        print(f'Installed {installed}; latest release {rel["version"]}.')
        print('An update is available: sudo ezyspeech update' if newer else 'Up to date.')


def cmd_update(a):
    conf = load_conf()
    require_root(conf)
    before = current_release(conf)
    installed = version_of(before)
    rel = fetch_release(a.to)
    if not a.to and vtuple(rel['version']) <= vtuple(installed or '0') and not a.force:
        Out.info(f'Already up to date ({installed}).')
        return
    if not a.yes and sys.stdin.isatty():
        if input(f'Update EzySpeech {installed} -> {rel["version"]}? [y/N] ').strip().lower() not in ('y', 'yes'):
            return
    Out.step(5, f'Downloading {rel["version"]}')
    with tempfile.TemporaryDirectory() as t:
        pkg = verified_download(rel, t)
        Out.step(15, 'Checked against its SHA-256; preparing it')
        release = stage_release(conf, pkg, rel['version'])
    if conf['mode'] == 'docker':
        Out.step(50, 'Building its image')
        compose(conf, 'build', release=release)
    elif conf['mode'] == 'podman':
        Out.step(50, 'Building its image')
        podman_build(release, rel['version'])
    Out.step(70, 'Bringing the settings up to date')
    run_init(conf, release, {})
    Out.step(80, f'Switching to {rel["version"]}')
    link_current(conf, release)
    restart(conf)
    Out.step(90, 'Checking it came up')
    if not wait_healthy(conf, rel['version']):
        Out.info(f'{rel["version"]} did not come up healthy; going back to {installed}.')
        link_current(conf, before)
        restart(conf)
        wait_healthy(conf, installed)
        # Kept, it would be the "newer release" a rollback could be pointed at.
        discard(conf, release)
        raise Fail(f'Update to {rel["version"]} failed and was rolled back to {installed}. '
                   'Its log: ezyspeech logs')
    prune(conf)
    Out.step(95, 'Finishing')
    # The rest is done by the new release's own copy of this command, so a
    # change to it takes effect on the update that brings it.
    if run([sys.executable, str(release / 'ops' / 'ezyspeech'), 'finish-update'],
           check=False).returncode:
        Out.info('Finishing the update went wrong; it can be retried: ezyspeech finish-update')
    Out.step(100, f'Updated to {rel["version"]}')


def cmd_finish_update(a):
    """After an update: the command on the PATH, and the Cockpit module."""
    conf = load_conf()
    require_root(conf)
    cur = current_release(conf)
    link_command(conf, cur)
    # Installed before backups ran on a timer: turned on once, as a new install
    # has them. Once anyone has turned them on or off, that choice stands.
    if not conf.get('auto_backup') and shutil.which('systemctl'):
        try:
            set_auto_backup(conf, True)
            Out.info(f'Backups now run on a timer: {AUTO_BACKUP_WHEN}, the newest {AUTO_BACKUP_KEEP} kept '
                     '(ezyspeech auto-backup off to stop them).')
        except Fail as exc:
            Out.info(f'Backups on a timer were not set up: {exc}')
    if COCKPIT_DIR.exists():
        try:
            rel = fetch_release(version_of(cur))
            if rel.get('cockpit'):
                with tempfile.TemporaryDirectory() as t:
                    install_cockpit(str(verified_download(rel, t, 'cockpit')))
        except Exception as exc:                # the update itself went through
            Out.info(f'The Cockpit module was not updated: {exc}')


def cmd_rollback(a):
    conf = load_conf()
    require_root(conf)
    target = rollback_target(conf)
    if not target:
        raise Fail('There is no earlier release kept to go back to.')
    link_current(conf, target)
    restart(conf)
    if not wait_healthy(conf, version_of(target)):
        raise Fail(f'{target.name} did not come up healthy either. See: ezyspeech logs')
    link_command(conf, target)
    Out.info(f'Back on {target.name}.')


def cmd_service(a):
    conf = load_conf()
    require_root(conf)
    {'start': start, 'stop': stop, 'restart': restart}[a.command](conf)
    # Done means answering again, not merely asked to start
    if a.command != 'stop' and not wait_healthy(conf, version_of(current_release(conf))):
        raise Fail('It did not come back up healthy. See: ezyspeech logs')


def cmd_logs(a):
    conf = load_conf()
    if conf['mode'] == 'native':
        cmd = ['journalctl', '-n', str(a.lines), '--no-pager', '-o', 'short-iso']
        for u in SERVICE_UNITS:
            cmd += ['-u', u]
        if a.follow:
            cmd.append('-f')
        os.execvp(cmd[0], cmd)
    elif conf['mode'] == 'podman':
        cmd = ['podman', 'logs', '--timestamps', '--tail', str(a.lines), *(['-f'] if a.follow else []), PODMAN_NAME]
        os.execvp(cmd[0], cmd)
    else:
        cur = current_release(conf)
        cmd = [*compose_cmd(conf, cur), 'logs', '--tail', str(a.lines)] + (['-f'] if a.follow else [])
        os.environ['EZY_VERSION'] = version_of(cur) or 'local'
        os.execvp(cmd[0], cmd)


def cmd_password(a):
    conf = load_conf()
    require_root(conf)
    password = None
    if a.generate:
        alphabet = 'abcdefghjkmnpqrstuvwxyz23456789'
        raw = ''.join(secrets.choice(alphabet) for _ in range(16))
        password = '-'.join(raw[i:i + 4] for i in range(0, 16, 4))
    elif a.stdin:                               # from the Cockpit module: kept off the command line
        password = sys.stdin.readline().rstrip('\n')
    elif not a.json:
        import getpass
        password = getpass.getpass('New admin password: ')
        if getpass.getpass('Again: ') != password:
            raise Fail('They do not match; nothing was changed.')
    if not password or len(password) < 8:
        raise Fail('At least 8 characters; nothing was changed.')
    cur = current_release(conf)
    if conf['mode'] == 'native':
        run(['runuser', '-u', conf['user'], '--', 'env', f'EZY_STATE={conf["state"]}',
             str(cur / '.venv/bin/python'), 'docker/init.py', 'password'],
            cwd=str(cur), capture=True, env={'EZY_ADMIN_PASSWORD': password})
    elif conf['mode'] == 'podman':
        run(['podman', 'exec', '-e', 'EZY_ADMIN_PASSWORD', PODMAN_NAME, 'ezyspeech', 'password'],
            capture=True, env={'EZY_ADMIN_PASSWORD': password})
    else:
        compose(conf, 'exec', '-T', 'ezyspeech', 'ezyspeech', 'password', password, capture=True)
    restart(conf)
    # Back up before saying so, so the new password can be used at once
    if not wait_healthy(conf, version_of(cur)):
        raise Fail('The password is set, but the servers did not come back up healthy. See: ezyspeech logs')
    if a.json:
        print(json.dumps({'password': password if a.generate else None}))
    else:
        print('Admin password set' + (f': {password}' if a.generate else '') + '. The servers restarted.')


# ── backups ──────────────────────────────────────────────────────────────────
# A backup is the whole state (settings, secrets, transcripts) as one .tar.gz,
# laid out the same whichever way it was installed, so one made natively can
# be restored into Docker or Podman and the other way round.

BACKUP_UNITS = ('ezyspeech-backup.service', 'ezyspeech-backup.timer')
AUTO_BACKUP_WHEN = 'Sun 14:00'              # after a Sunday morning service
AUTO_BACKUP_KEEP = 8


def backup_dir(conf):
    if os.geteuid() == 0:
        return Path(conf.get('backup_dir') or '/var/backups/ezyspeech')
    return home_of(conf) / 'backups'


def write_backup(conf, dest):
    dest = Path(dest)
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_name(dest.name + '.part')
    if conf['mode'] == 'native':
        run(['tar', 'czf', str(tmp), '-C', conf['state'], '.'])
    elif conf['mode'] == 'podman':
        with open(tmp, 'wb') as out:
            podman_run(conf, version_of(current_release(conf)), 'czf', '-', '-C', '/var/lib/ezyspeech', '.',
                       entrypoint='tar', stdout=out)
    else:
        with open(tmp, 'wb') as out:
            cur = current_release(conf)
            subprocess.run([*compose_cmd(conf, cur), 'run', '--rm', '--no-deps', '-T', '--entrypoint', 'tar',
                            'ezyspeech', 'czf', '-', '-C', '/var/lib/ezyspeech', '.'],
                           stdout=out, check=True, env={**os.environ, 'EZY_VERSION': version_of(cur)})
    os.chmod(tmp, 0o600)                    # it holds the secrets
    os.replace(tmp, dest)                   # never half a file under the real name
    return dest


def list_backups(conf):
    found = []
    d = backup_dir(conf)
    if d.is_dir():
        for f in sorted(d.glob('ezyspeech-*.tar.gz'), key=lambda p: p.stat().st_mtime, reverse=True):
            st = f.stat()
            found.append({'file': str(f), 'name': f.name, 'size': st.st_size, 'time': int(st.st_mtime),
                          'auto': f.name.startswith('ezyspeech-auto-')})
    return found


def cmd_backup(a):
    conf = load_conf()
    if a.list:
        items = list_backups(conf)
        if a.json:
            print(json.dumps({'dir': str(backup_dir(conf)), 'backups': items, 'auto': auto_backup_state(conf)}))
        else:
            for b in items:
                print(f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(b['time']))}  "
                      f"{b['size'] / 1e6:6.1f} MB  {b['file']}")
        return
    require_root(conf)
    stamp = time.strftime('%Y%m%d-%H%M%S')
    if a.file:
        dest = Path(a.file).resolve()
    else:
        dest = backup_dir(conf) / f"ezyspeech-{'auto-' if a.auto else ''}{stamp}.tar.gz"
    write_backup(conf, dest)
    if a.auto:                              # the timer's: keep the newest few
        keep = int(conf.get('auto_backup_keep') or AUTO_BACKUP_KEEP)
        for old in [b for b in list_backups(conf) if b['auto']][keep:]:
            Path(old['file']).unlink(missing_ok=True)
    print(f'Saved {dest}')


def check_backup(path):
    """A backup of this program's state, and nothing that would land outside it."""
    try:
        with tarfile.open(path) as tar:
            names = tar.getnames()
    except (OSError, tarfile.TarError) as exc:
        raise Fail(f'{path} is not a backup this can read: {exc}')
    for n in names:
        if n.startswith('/') or '..' in Path(n).parts:
            raise Fail(f'{path} has a path that would land outside the state ({n}); not restoring it.')
    if not any(n.lstrip('./') == 'config/config.yaml' for n in names):
        raise Fail(f'{path} has no config/config.yaml: not an EzySpeech backup.')


def cmd_restore(a):
    conf = load_conf()
    require_root(conf)
    path = Path(a.file).resolve()
    if not path.is_file():
        raise Fail(f'No such file: {path}')
    check_backup(path)
    if not a.yes and sys.stdin.isatty():
        if input(f'Replace the settings, admin password and transcripts with those in {path.name}? '
                 'The ones there now are backed up first. [y/N] ').strip().lower() not in ('y', 'yes'):
            return
    cur = current_release(conf)
    Out.step(10, 'Backing up what is there now')
    before = write_backup(conf, backup_dir(conf) / f"ezyspeech-before-restore-{time.strftime('%Y%m%d-%H%M%S')}.tar.gz")
    Out.step(30, 'Stopping')
    stop(conf)
    Out.step(50, f'Restoring {path.name}')
    clear_and_extract = 'find /var/lib/ezyspeech -mindepth 1 -delete && tar xzf - -C /var/lib/ezyspeech'
    if conf['mode'] == 'native':
        state = Path(conf['state'])
        for item in state.iterdir():
            shutil.rmtree(item) if item.is_dir() and not item.is_symlink() else item.unlink()
        with tarfile.open(path) as tar:
            try:
                tar.extractall(state, filter='data')
            except TypeError:               # Python before 3.12
                tar.extractall(state)
        run(['chown', '-R', f'{conf["user"]}:{conf["user"]}', str(state)])
        run(['chmod', '750', str(state)])
        if shutil.which('restorecon'):
            run(['restorecon', '-R', str(state)], check=False, quiet=True)
    elif conf['mode'] == 'podman':
        with open(path, 'rb') as src:
            podman_run(conf, version_of(cur), '-c', clear_and_extract, entrypoint='sh', stdin=src)
    else:
        with open(path, 'rb') as src:
            subprocess.run([*compose_cmd(conf, cur), 'run', '--rm', '--no-deps', '-T', '--entrypoint', 'sh',
                            'ezyspeech', '-c', clear_and_extract],
                           stdin=src, check=True, env={**os.environ, 'EZY_VERSION': version_of(cur)})
    Out.step(70, 'Bringing the settings up to date')
    run_init(conf, cur, {})                 # an older backup may lack newer settings
    Out.step(85, 'Starting')
    start(conf)
    if not wait_healthy(conf, version_of(cur)):
        raise Fail(f'Restored, but it did not come up healthy. What was there before is in {before}; '
                   f'ezyspeech restore {before} puts it back.')
    Out.step(100, f'Restored {path.name}')
    Out.info(f'What was there before is kept in {before}.')


# ── backups, on a timer ──────────────────────────────────────────────────────

def auto_backup_state(conf):
    on = Path('/etc/systemd/system', BACKUP_UNITS[1]).exists()
    active = on and run(['systemctl', 'is-enabled', BACKUP_UNITS[1]], check=False,
                        capture=True).stdout.strip() == 'enabled'
    return {'on': bool(active), 'when': conf.get('auto_backup_when') or AUTO_BACKUP_WHEN,
            'keep': int(conf.get('auto_backup_keep') or AUTO_BACKUP_KEEP),
            'possible': bool(shutil.which('systemctl')) and os.geteuid() == 0}


def set_auto_backup(conf, on, when=None, keep=None):
    if not shutil.which('systemctl'):
        raise Fail('Backups on a timer need systemd.')
    if when:
        r = run(['systemd-analyze', 'calendar', when], check=False, capture=True)
        if r.returncode != 0:
            raise Fail(f'"{when}" is not a time systemd understands, such as "Sun 14:00" or "daily".')
        conf['auto_backup_when'] = when
    if keep:
        conf['auto_backup_keep'] = str(int(keep))
    conf['auto_backup'] = 'on' if on else 'off'     # chosen, so an update leaves it be
    save_conf(conf, conf['_path'])
    service, timer = (Path('/etc/systemd/system', u) for u in BACKUP_UNITS)
    if on:
        service.write_text(f"""[Unit]
Description=EzySpeech: back up settings, secrets and transcripts

[Service]
Type=oneshot
ExecStart={home_of(conf) / 'current' / 'ops' / 'ezyspeech'} backup --auto
""")
        timer.write_text(f"""[Unit]
Description=EzySpeech: regular backup

[Timer]
OnCalendar={conf.get('auto_backup_when') or AUTO_BACKUP_WHEN}
# Missed while the machine was off: run at the next start
Persistent=true
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
""")
        systemctl('daemon-reload')
        systemctl('enable', '--now', BACKUP_UNITS[1])
    else:
        systemctl('disable', '--now', BACKUP_UNITS[1], check=False)
        for u in (service, timer):
            if u.exists():
                u.unlink()
        systemctl('daemon-reload', check=False)


def cmd_auto_backup(a):
    conf = load_conf()
    if a.state == 'status':
        st = auto_backup_state(conf)
        if a.json:
            print(json.dumps(st))
        else:
            print(f"Backups on a timer: {'on' if st['on'] else 'off'}; when: {st['when']}; "
                  f"keeping the newest {st['keep']}, in {backup_dir(conf)}")
        return
    require_root(conf)
    set_auto_backup(conf, a.state == 'on', a.when, a.keep)
    st = auto_backup_state(conf)
    print(f"Backups on a timer: {'on, ' + st['when'] + ', keeping ' + str(st['keep']) if st['on'] else 'off'}")


def cmd_uninstall(a):
    conf = load_conf()
    require_root(conf)
    if not a.yes and sys.stdin.isatty():
        what = ' and DELETE its settings, secrets and transcripts' if a.purge else ''
        if input(f'Uninstall EzySpeech{what}? [y/N] ').strip().lower() not in ('y', 'yes'):
            return
    if Path('/etc/systemd/system', BACKUP_UNITS[1]).exists():
        set_auto_backup(conf, False)        # the backups made are left where they are
    if conf['mode'] == 'native':
        systemctl('disable', '--now', *SERVICE_UNITS, check=False)
        for u in SERVICE_UNITS:
            unit = Path('/etc/systemd/system', u)
            if unit.exists():
                unit.unlink()
        systemctl('daemon-reload', check=False)
        if a.purge:
            shutil.rmtree(conf['state'], ignore_errors=True)
            run(['userdel', conf['user']], check=False, quiet=True)
    elif conf['mode'] == 'podman':
        systemctl('stop', PODMAN_UNIT, check=False)
        if QUADLET.exists():
            QUADLET.unlink()
        systemctl('daemon-reload', check=False)
        run(['podman', 'rm', '-f', PODMAN_NAME], check=False, quiet=True)
        for r in releases(conf):
            run(['podman', 'image', 'rm', podman_image(r.name)], check=False, quiet=True)
        if a.purge:
            run(['podman', 'volume', 'rm', PODMAN_NAME], check=False, quiet=True)
    else:
        compose(conf, 'down', *(['-v'] if a.purge else []), check=False)
        for r in releases(conf):
            run(['docker', 'image', 'rm', f'ezyspeech:{r.name}'], check=False, quiet=True)
    shutil.rmtree(conf['home'], ignore_errors=True)
    for link in (Path('/usr/local/bin/ezyspeech'), Path('/usr/bin/ezyspeech'),
                 Path.home() / '.local/bin/ezyspeech'):
        if link.is_symlink():
            link.unlink()
    Path(conf['_path']).unlink()
    print('EzySpeech is uninstalled.' + ('' if a.purge else
          ' Its settings and transcripts were kept' + (
              f' in {conf["state"]}.' if conf['mode'] == 'native'
              else f' in the Podman volume {PODMAN_NAME}.' if conf['mode'] == 'podman'
              else ' in the Docker volume ezyspeech_ezyspeech.')))


def cmd_menu(a):
    conf = load_conf()
    script = current_release(conf) / 'install.sh'
    os.execvp('bash', ['bash', str(script), '--manage'])


def main(argv):
    p = argparse.ArgumentParser(prog='ezyspeech', description='Install, update and run EzySpeech.')
    sub = p.add_subparsers(dest='command', required=True)
    s = sub.add_parser('status'); s.add_argument('--json', action='store_true'); s.set_defaults(func=cmd_status)
    sub.add_parser('version').set_defaults(func=cmd_version)
    s = sub.add_parser('check-update'); s.add_argument('--json', action='store_true'); s.set_defaults(func=cmd_check)
    s = sub.add_parser('update')
    s.add_argument('--yes', '-y', action='store_true'); s.add_argument('--to')
    s.add_argument('--force', action='store_true'); s.add_argument('--progress', action='store_true')
    s.set_defaults(func=cmd_update)
    sub.add_parser('rollback').set_defaults(func=cmd_rollback)
    sub.add_parser('finish-update', help='run by update; safe to repeat').set_defaults(func=cmd_finish_update)
    sub.add_parser('menu', help='the installer\'s management screens').set_defaults(func=cmd_menu)
    for name in ('start', 'stop', 'restart'):
        sub.add_parser(name).set_defaults(func=cmd_service)
    s = sub.add_parser('logs'); s.add_argument('-f', '--follow', action='store_true')
    s.add_argument('-n', '--lines', type=int, default=100); s.set_defaults(func=cmd_logs)
    s = sub.add_parser('password'); s.add_argument('--generate', action='store_true')
    s.add_argument('--stdin', action='store_true', help='read it from standard input')
    s.add_argument('--json', action='store_true'); s.set_defaults(func=cmd_password)
    s = sub.add_parser('backup', help='back up now; --list the backups kept')
    s.add_argument('file', nargs='?'); s.add_argument('--list', action='store_true')
    s.add_argument('--json', action='store_true')
    s.add_argument('--auto', action='store_true', help=argparse.SUPPRESS)   # the timer's
    s.set_defaults(func=cmd_backup)
    s = sub.add_parser('restore', help='put a backup back, after backing up what is there')
    s.add_argument('file'); s.add_argument('--yes', '-y', action='store_true')
    s.add_argument('--progress', action='store_true'); s.set_defaults(func=cmd_restore)
    s = sub.add_parser('auto-backup', help='backups on a timer: on, off or status')
    s.add_argument('state', choices=['on', 'off', 'status'])
    s.add_argument('--when', help='a systemd calendar time, such as "Sun 14:00" or daily')
    s.add_argument('--keep', type=int, help='how many to keep')
    s.add_argument('--json', action='store_true'); s.set_defaults(func=cmd_auto_backup)
    s = sub.add_parser('uninstall'); s.add_argument('--purge', action='store_true')
    s.add_argument('--yes', '-y', action='store_true'); s.set_defaults(func=cmd_uninstall)
    s = sub.add_parser('install')
    s.add_argument('--mode', choices=['native', 'docker', 'podman'], required=True)
    s.add_argument('--source', required=True, help='release package (.tar.gz) or code directory')
    s.add_argument('--home'); s.add_argument('--state'); s.add_argument('--user')
    s.add_argument('--port', type=int, default=1915); s.add_argument('--admin-port', type=int, default=1916)
    s.add_argument('--https', choices=['off', 'self-signed']); s.add_argument('--hostnames')
    s.add_argument('--external-url'); s.add_argument('--tz')
    s.add_argument('--cockpit', help='Cockpit module package or URL to install')
    s.add_argument('--migrate-from', help='an ezy_manager.py install to bring settings over from')
    s.add_argument('--force', action='store_true'); s.add_argument('--progress', action='store_true')
    s.add_argument('--no-auto-backup', action='store_true', help='no backups on a timer')
    s.set_defaults(func=cmd_install)
    a = p.parse_args(argv)
    Out.progress = getattr(a, 'progress', False)
    # Machine-read output (Cockpit reads it) is the JSON and nothing else.
    Out.quiet = getattr(a, 'json', False)
    try:
        a.func(a)
    except Fail as e:
        print(f'ezyspeech: {e}', file=sys.stderr)
        if Out.progress:
            print(f'FAILED {e}', flush=True)
        return 1
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
