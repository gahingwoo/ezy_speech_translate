def step_words(text):
    lang = os.environ.get('EZY_LANG', '').lower()
    if lang.startswith('zh') or lang == 'yue':
        for pattern, zh in STEP_ZH:
            if pattern.match(text):
                text = pattern.sub(zh, text)
                # systemd's day names, in a timer's time
                for en, day in (('Mon', '周一'), ('Tue', '周二'), ('Wed', '周三'), ('Thu', '周四'),
                                ('Fri', '周五'), ('Sat', '周六'), ('Sun', '周日'), ('daily', '每天')):
                    text = re.sub(rf'\b{en}\b', '每' + day if day.startswith('周') else day, text)
                return text
    return text


class Out:
    progress = False      # PROGRESS <percent> <text> lines, for install.sh's gauge
    quiet = False

    @classmethod
    def step(cls, percent, text):
        text = step_words(text)
        if cls.progress:
            print(f'PROGRESS {int(percent)} {text}', flush=True)
        elif not cls.quiet:
            print(f'==> {text}', flush=True)

    @classmethod
    def info(cls, text):
        if not cls.quiet:
            print(text, flush=True)


def run(cmd, check=True, capture=False, env=None, cwd=None, quiet=False):
    """Run a command; its output goes to ours unless captured or quietened."""
    kwargs = {'cwd': cwd, 'env': {**os.environ, **(env or {})}}
    if capture:
        kwargs.update(stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    elif quiet or Out.progress or Out.quiet:
        # Kept, not shown: if it fails, its last lines are the error.
        kwargs.update(stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    result = subprocess.run(cmd, **kwargs)
    if check and result.returncode != 0:
        detail = result.stdout or '' if isinstance(result.stdout, str) else ''
        raise Fail(f'{" ".join(map(str, cmd))} failed ({result.returncode})'
                   + (f':\n{detail.strip()[-1500:]}' if detail else ''))
    return result


# ── the install's record ─────────────────────────────────────────────────────

def load_conf(required=True):
    for path in CONF_PATHS:
        if path.is_file():
            conf = {}
            for line in path.read_text().splitlines():
                if '=' in line and not line.lstrip().startswith('#'):
                    k, v = line.split('=', 1)
                    conf[k.strip()] = v.strip()
            conf['_path'] = str(path)
            return conf
    if required:
        raise Fail('EzySpeech is not installed here (no install.conf). Install it with install.sh.')
    return None


def save_conf(conf, path):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    body = '# Written by ezyspeech. The install this machine runs.\n' + ''.join(
        f'{k}={v}\n' for k, v in conf.items() if not k.startswith('_'))
    path.write_text(body)


def home_of(conf):
    return Path(conf['home'])


def current_release(conf):
    link = home_of(conf) / 'current'
    return link.resolve() if link.exists() else None


def version_of(release_dir):
    try:
        return (Path(release_dir) / 'VERSION').read_text().strip()
    except OSError:
        return None


def releases(conf):
    base = home_of(conf) / 'releases'
    found = [p for p in base.iterdir() if p.is_dir() and not p.name.endswith('.new')] if base.is_dir() else []
    return sorted(found, key=lambda p: vtuple(p.name))


def vtuple(v):
    parts = re.findall(r'\d+', str(v).lstrip('v'))
    return tuple(int(x) for x in parts[:3]) + (0,) * (3 - len(parts[:3]))


def require_root(conf=None):
    if conf and conf.get('mode') == 'docker' and not conf.get('_path', '').startswith('/etc/'):
        return
    if os.geteuid() != 0:
        raise Fail('This needs root. Run it with sudo.')


# ── releases ─────────────────────────────────────────────────────────────────

def _open(url, timeout=30):
    req = urllib.request.Request(url, headers={
        'User-Agent': 'ezyspeech-updater', 'Accept': 'application/vnd.github+json'})
    return urllib.request.urlopen(req, timeout=timeout, context=ssl.create_default_context())


def release_api():
    """Where releases come from: GitHub, unless the environment or the
    install says otherwise (a fork, or a test)."""
    if os.environ.get('EZY_RELEASE_API'):
        return os.environ['EZY_RELEASE_API']
    conf = load_conf(required=False) or {}
    return conf.get('release_api') or RELEASE_API


def fetch_release(tag=None):
    """{version, tarball, sums, cockpit, notes, url} for the latest release, or tag."""
    api = release_api()
    url = f'{api}/tags/v{tag.lstrip("v")}' if tag else f'{api}/latest'
    try:
        with _open(url) as resp:
            data = json.load(resp)
    except urllib.error.HTTPError as exc:
        if exc.code == 404:
            raise Fail(f'No release {"v" + tag.lstrip("v") + " " if tag else ""}has been published yet.')
        raise Fail(f'The release list answered {exc.code} ({url}).')
    except Exception as exc:
        raise Fail(f'Could not reach the release list ({url}): {exc}')
    version = str(data.get('tag_name', '')).lstrip('v')
    assets = {a.get('name'): a.get('browser_download_url') for a in data.get('assets') or []}
    tarball = assets.get(f'ezyspeech-{version}.tar.gz')
    if not version or not tarball or 'SHA256SUMS' not in assets:
        raise Fail(f'Release {data.get("tag_name") or "?"} is missing its package or its sums.')
    return {'version': version, 'tarball': tarball, 'sums': assets['SHA256SUMS'],
            'cockpit': assets.get(f'ezyspeech-cockpit-{version}.tar.gz'),
            'notes': data.get('body') or '', 'url': data.get('html_url') or ''}


def download(url, dest):
    with _open(url, timeout=120) as resp, open(dest, 'wb') as out:
        shutil.copyfileobj(resp, out)


def verified_download(release, workdir, asset_key='tarball'):
    """Download an asset of a release and check it against SHA256SUMS."""
    url = release[asset_key]
    name = url.rsplit('/', 1)[-1]
    dest = Path(workdir) / name
    sums_file = Path(workdir) / 'SHA256SUMS'
    if not sums_file.exists():
        download(release['sums'], sums_file)
    download(url, dest)
    expected = None
    for line in sums_file.read_text().splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[1].lstrip('*') == name:
            expected = parts[0].lower()
    actual = hashlib.sha256(dest.read_bytes()).hexdigest()
    if not expected or expected != actual:
        raise Fail(f'{name} does not match its published SHA-256; not installing it.')
    return dest


def extract(tarball, into):
    """Unpack a release package, refusing any path that would land outside."""
    into = Path(into)
    with tarfile.open(tarball) as tar:
        members = tar.getmembers()
        # The package's one folder. Not counting what macOS's tar adds beside
        # a folder (._name, __MACOSX) or a leading ./
        names = [m.name[2:] if m.name.startswith('./') else m.name for m in members]
        top = {n.split('/', 1)[0] for n in names
               if n and n != '.' and not n.split('/', 1)[0].startswith(('._', '__MACOSX'))}
        for m in members:
            target = (into / m.name).resolve()
            if not str(target).startswith(str(into.resolve())) or m.issym() and os.path.isabs(m.linkname):
                raise Fail(f'The package contains an unsafe path: {m.name}')
        # Python's own guard as well, where it has one (3.12 and later).
        kwargs = {'filter': 'data'} if hasattr(tarfile, 'data_filter') else {}
        tar.extractall(into, **kwargs)
    return into / top.pop() if len(top) == 1 else into


# ── preparing a release to run ───────────────────────────────────────────────

def stage_release(conf, source, version):
    """Put a release's code under releases/<version> and get it ready to run.
    source is a .tar.gz package or a directory of code."""
    home = home_of(conf)
    final = home / 'releases' / version
    if final.exists() and (final / '.ready').exists():
        return final
    work = home / 'releases' / f'{version}.new'
    shutil.rmtree(work, ignore_errors=True)
    work.parent.mkdir(parents=True, exist_ok=True)
    try:
        _stage(conf, source, version, work)
    except BaseException:
        shutil.rmtree(work, ignore_errors=True)     # nothing half-made is left behind
        raise
    shutil.rmtree(final, ignore_errors=True)
    work.rename(final)
    return final


def _stage(conf, source, version, work):
    home = home_of(conf)
    if Path(source).is_dir():
        shutil.copytree(source, work, symlinks=True, ignore=shutil.ignore_patterns(
            '.git', 'venv', '.venv', '__pycache__', 'node_modules', '.env', 'data', 'logs', 'exports'))
    else:
        tmp = Path(tempfile.mkdtemp(dir=home / 'releases'))
        root = extract(source, tmp)
        root.rename(work)
        shutil.rmtree(tmp, ignore_errors=True)
    if not (work / 'VERSION').exists():
        raise Fail('The package does not hold a release (no VERSION file).')
    if conf['mode'] == 'native':
        prepare_native(conf, work)
    (work / '.ready').write_text(version + '\n')


def prepare_native(conf, release):
    # an update too: a machine installed on Python 3.9 gets 3.10+ here
    ensure_native_packages()
    state = Path(conf['state'])
    # The shipped config.yaml is the default a new install starts from; the
    # live one is in the state, like everything the servers write.
    cfg = release / 'config'
    if cfg.is_dir() and not cfg.is_symlink():
        shutil.rmtree(release / 'config.dist', ignore_errors=True)
        cfg.rename(release / 'config.dist')
    for rel, sub in STATE_LINKS.items():
        p = release / rel
        if p.is_symlink() or p.is_file():
            p.unlink()
        elif p.is_dir():
            shutil.rmtree(p)
        p.parent.mkdir(parents=True, exist_ok=True)
        p.symlink_to(state / sub)
    Out.info('    creating its Python environment (a minute or so)')
    run([app_python(), '-m', 'venv', str(release / '.venv')])
    pip = [str(release / '.venv/bin/python'), '-m', 'pip', '--disable-pip-version-check', '-q']
    cache = {'PIP_CACHE_DIR': '/var/cache/ezyspeech/pip'}
    run(pip + ['install', '--upgrade', 'pip'], quiet=True, env=cache)
    run(pip + ['install', '-r', str(release / 'requirements.txt')], env=cache)
    run(['chmod', '-R', 'a+rX', str(release)])


def link_current(conf, release):
    link = home_of(conf) / 'current'
    tmp = home_of(conf) / '.current.tmp'
    if tmp.is_symlink():
        tmp.unlink()
    tmp.symlink_to(Path('releases') / Path(release).name)
    os.replace(tmp, link)                   # atomic: never a moment without one


def discard(conf, release):
    """A release and, for a container install, its image."""
    shutil.rmtree(release, ignore_errors=True)
    if conf['mode'] == 'docker':
        run(['docker', 'image', 'rm', f'ezyspeech:{release.name}'], check=False, quiet=True)
    elif conf['mode'] == 'podman':
        run(['podman', 'image', 'rm', podman_image(release.name)], check=False, quiet=True)


def prune(conf):
    """Keep the running release and the one before it."""
    keep = {current_release(conf)}
    olds = [r for r in releases(conf) if r not in keep]
    for r in olds[:-max(0, KEEP_RELEASES - 1)] if KEEP_RELEASES > 1 else olds:
        discard(conf, r)


def rollback_target(conf):
    """The release `rollback` goes back to: the newest one older than the
    one in use. The page asks for it too, so the two cannot disagree."""
    cur = current_release(conf)
    older = [r for r in releases(conf) if cur and vtuple(r.name) < vtuple(cur.name)]
    return older[-1] if older else None


# ── health ───────────────────────────────────────────────────────────────────

def settings_in(text):
    """The two-level "section: / key: value" settings of a config.yaml."""
    found, section = {}, None
    for line in text.splitlines():
        m = re.match(r'^([a-z_]+):\s*(#.*)?$', line)
        if m:
            section = m.group(1)
            continue
        m = re.match(r'^\s+([a-z_]+):\s*(.*?)\s*(#.*)?$', line)
        if m and section:
            value = m.group(2).strip('\'"')
            if value not in ('', 'null', '~'):
                found[f'{section}.{m.group(1)}'] = value
    return found


def settings(conf):
    """What the installed config.yaml says, as far as settings_in can read it."""
    if conf['mode'] == 'native':
        try:
            return settings_in((Path(conf['state']) / 'config' / 'config.yaml').read_text())
        except OSError:
            return {}
    if conf['mode'] == 'podman':
        r = run(['podman', 'exec', PODMAN_NAME, 'cat', '/var/lib/ezyspeech/config/config.yaml'],
                capture=True, check=False)
    else:
        r = compose(conf, 'exec', '-T', 'ezyspeech', 'cat', '/var/lib/ezyspeech/config/config.yaml',
                    capture=True, check=False)
    return settings_in(r.stdout) if r.returncode == 0 else {}


def ports(conf):
    """The two ports, as the running configuration has them."""
    port, admin = conf.get('port', '1915'), conf.get('admin_port', '1916')
    if conf['mode'] == 'native':
        found = settings(conf)
        port = found.get('server.port') or port
        admin = found.get('admin_server.port') or admin
    else:
        env = docker_env(conf)
        port, admin = env.get('EZY_PORT', port), env.get('EZY_ADMIN_PORT', admin)
    return int(port), int(admin)


def probe(port, path):
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    for scheme in ('http', 'https'):
        try:
            with urllib.request.urlopen(f'{scheme}://127.0.0.1:{port}{path}', timeout=3,
                                        context=ctx if scheme == 'https' else None) as r:
                return json.loads(r.read().decode() or '{}')
        except Exception:
            continue
    return None


def health(conf):
    port, admin = ports(conf)
    user = probe(port, '/api/health')
    adm = probe(admin, '/health')
    return {'listener': bool(user), 'console': bool(adm),
            'version': (user or {}).get('version'), 'port': port, 'admin_port': admin,
            'listeners': (user or {}).get('clients')}


def wait_healthy(conf, version, timeout=HEALTH_TIMEOUT):
    deadline = time.time() + timeout
    while time.time() < deadline:
        h = health(conf)
        if h['listener'] and h['console'] and (not version or h['version'] == version):
            return True
        time.sleep(2)
    return False


# ── the kinds of install ─────────────────────────────────────────────────────

def docker_env(conf):
    env = {}
    path = home_of(conf) / '.env'
    if path.is_file():
        for line in path.read_text().splitlines():
            if '=' in line and not line.startswith('#'):
                k, v = line.split('=', 1)
                env[k.strip()] = v.strip()
    return env


def set_docker_env(conf, values):
    path = home_of(conf) / '.env'
    lines = path.read_text().splitlines() if path.is_file() else []
    keys = set(values)
    kept = [l for l in lines if l.split('=', 1)[0].strip() not in keys]
    path.write_text('\n'.join(kept + [f'{k}={v}' for k, v in values.items() if v is not None]) + '\n')


def compose_cmd(conf, release):
    """docker compose for a release. Its own folder is the project folder, so
    the build finds its Dockerfile; the install's settings are in <home>/.env.
    The project, and so the volume, is named in compose.yaml: ezyspeech."""
    env_file = home_of(conf) / '.env'
    return ['docker', 'compose', '-f', str(Path(release) / 'compose.yaml'),
            *(['--env-file', str(env_file)] if env_file.exists() else [])]


def compose(conf, *args, release=None, capture=False, check=True):
    release = Path(release or current_release(conf))
    cmd = [*compose_cmd(conf, release), *args]
    return run(cmd, capture=capture, check=check,
               env={'EZY_VERSION': version_of(release) or 'local'})


# Handed to the first setup only, never kept in .env: the container applies
# .env on every start, which would undo a change made later on the settings page.
ONCE_ONLY = ('EZY_ADMIN_PASSWORD', 'EZY_TRANSLATION_PROVIDERS')


def podman_image(version):
    return f'localhost/ezyspeech:{version}'


def podman_build(release, version):
    # Docker's format, which keeps the image's HEALTHCHECK; Podman's own drops it.
    run(['podman', 'build', '--format', 'docker', '-t', podman_image(version), str(release)], quiet=True)


def podman_run(conf, version, *args, env=None, capture=True, check=True, entrypoint=None, stdout=None,
               stdin=None):
    """A one-off container from a release's image, on the install's volume
    and settings. Values in env are handed over by name (`-e NAME`), so a
    password never appears on a command line."""
    env = {k: v for k, v in (env or {}).items() if v is not None}
    env_file = home_of(conf) / '.env'
    cmd = ['podman', 'run', '--rm', *(['-i'] if stdin is not None else []),
           '-v', f'{PODMAN_NAME}:/var/lib/ezyspeech',
           *(['--env-file', str(env_file)] if env_file.exists() else []),
           *[x for k in env for x in ('-e', k)],
           *(['--entrypoint', entrypoint] if entrypoint else []),
           podman_image(version), *args]
    if stdout is not None or stdin is not None:
        return subprocess.run(cmd, stdout=stdout, stdin=stdin, check=check, env={**os.environ, **env})
    return run(cmd, capture=capture, check=check, env=env)


def write_quadlet(conf, version):
    """The Quadlet file systemd turns into ezyspeech.service: the image of
    the release in use, its ports, its volume. A rollback or an update is this
    file pointing at another image, and a restart."""
    env = docker_env(conf)
    port, admin = env.get('EZY_PORT', conf.get('port', '1915')), env.get('EZY_ADMIN_PORT', conf.get('admin_port', '1916'))
    QUADLET.parent.mkdir(parents=True, exist_ok=True)
    QUADLET.write_text(f"""# Written by ezyspeech; it is rewritten on every update and rollback.
[Unit]
Description=EzySpeech, live speech translation (Podman)
Wants=network-online.target
After=network-online.target

[Container]
ContainerName={PODMAN_NAME}
Image={podman_image(version)}
EnvironmentFile={home_of(conf) / '.env'}
# The container listens on the same numbers it publishes: the console builds
# the transcript server's address from its port, so the two must agree.
PublishPort={port}:{port}
PublishPort={admin}:{admin}
Volume={PODMAN_NAME}:/var/lib/ezyspeech
# (No StopTimeout: Podman 4.9, Ubuntu 24.04's, refuses the whole file for it.
# Both servers stop well within the default ten seconds.)

[Service]
Restart=always
# The first start may pull nothing but still has to set up the volume.
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
""")
    systemctl('daemon-reload')


def podman_version():
    r = run(['podman', 'version', '--format', '{{.Client.Version}}'], check=False, capture=True)
    return vtuple(r.stdout.strip()) if r.returncode == 0 else None


def systemctl(*args, check=True):
    return run(['systemctl', *args], check=check, quiet=True)


def services_state():
    out = {}
    for unit in SERVICE_UNITS:
        r = run(['systemctl', 'is-active', unit], check=False, capture=True)
        out[unit] = r.stdout.strip()
    return out


def _size(path):
    total = 0
    for root, _dirs, files in os.walk(path):
        for f in files:
            try:
                total += os.lstat(os.path.join(root, f)).st_size
            except OSError:
                pass
    return total


def _bytes(text):
    """'135.4MiB' -> bytes, as docker stats writes sizes."""
    m = re.match(r'([\d.]+)\s*([KMGT]?i?B)', text.strip())
    if not m:
        return None
    scale = {'B': 1, 'KB': 1e3, 'MB': 1e6, 'GB': 1e9, 'TB': 1e12,
             'KiB': 1024, 'MiB': 1024 ** 2, 'GiB': 1024 ** 3, 'TiB': 1024 ** 4}
    return int(float(m.group(1)) * scale.get(m.group(2), 1))


def usage(conf):
    """Memory and CPU of each server, how much the transcripts take, and how
    much room is left. CPU is a running total; a caller compares two readings."""
    procs = []
    if conf['mode'] == 'native':
        for unit, name in zip(SERVICE_UNITS, ('listener', 'console')):
            r = run(['systemctl', 'show', unit, '-p', 'MemoryCurrent,CPUUsageNSec,ActiveEnterTimestampMonotonic'],
                    check=False, capture=True)
            props = dict(line.split('=', 1) for line in r.stdout.splitlines() if '=' in line)
            num = lambda k: int(props[k]) if props.get(k, '').isdigit() else None
            procs.append({'name': name, 'memory': num('MemoryCurrent'), 'cpu_ns': num('CPUUsageNSec')})
        data = Path(conf['state']) / 'data'
        data_bytes = _size(data) if data.is_dir() else None
        where = conf['state']
    else:
        tool = 'podman' if conf['mode'] == 'podman' else 'docker'
        r = run([tool, 'stats', '--no-stream', '--format', '{{.Name}}|{{.CPUPerc}}|{{.MemUsage}}'],
                check=False, capture=True)
        for line in (r.stdout or '').splitlines():
            parts = line.split('|')
            if len(parts) == 3 and 'ezyspeech' in parts[0]:
                cpu = parts[1].rstrip('%')
                procs.append({'name': 'container', 'memory': _bytes(parts[2].split('/')[0]),
                              'cpu_percent': float(cpu) if cpu.replace('.', '', 1).isdigit() else None})
        if tool == 'podman':
            r = run(['podman', 'exec', PODMAN_NAME, 'du', '-sb', '/var/lib/ezyspeech/data'],
                    capture=True, check=False)
        else:
            r = compose(conf, 'exec', '-T', 'ezyspeech', 'du', '-sb', '/var/lib/ezyspeech/data',
                        capture=True, check=False)
        data_bytes = int(r.stdout.split()[0]) if r.returncode == 0 and r.stdout.split()[:1] and \
            r.stdout.split()[0].isdigit() else None
        where = conf['home']
    total = None
    try:
        for line in Path('/proc/meminfo').read_text().splitlines():
            if line.startswith('MemTotal:'):
                total = int(line.split()[1]) * 1024
    except OSError:
        pass
    try:
        free = shutil.disk_usage(where).free
    except OSError:
        free = None
    return {'processes': procs, 'memory_total': total, 'data_bytes': data_bytes,
            'disk_free': free, 'at_ns': time.monotonic_ns()}


def native_units(conf):
    home, state, user = conf['home'], conf['state'], conf['user']
    units = {}
    for unit, script, what in (('ezyspeech-user.service', 'app/user/server.py', 'listener and transcript server'),
                               ('ezyspeech-admin.service', 'app/admin/server.py', "operator's console")):
        units[unit] = f"""# Written by ezyspeech. Edit the install, not this file.
[Unit]
Description=EzySpeech {what}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={user}
Group={user}
WorkingDirectory={home}/current
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=EZY_STATE={state}
ExecStart={home}/current/.venv/bin/python {script}
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths={state}

[Install]
WantedBy=multi-user.target
"""
    return units


def start(conf):
    if conf['mode'] == 'native':
        systemctl('start', *SERVICE_UNITS)
    elif conf['mode'] == 'podman':
        write_quadlet(conf, version_of(current_release(conf)))
        systemctl('start', PODMAN_UNIT)
    else:
        compose(conf, 'up', '-d', '--remove-orphans')


def stop(conf):
    if conf['mode'] == 'native':
        systemctl('stop', *SERVICE_UNITS)
    elif conf['mode'] == 'podman':
        systemctl('stop', PODMAN_UNIT)
    else:
        compose(conf, 'stop')


def restart(conf):
    if conf['mode'] == 'native':
        systemctl('restart', *SERVICE_UNITS)
    elif conf['mode'] == 'podman':
        # the Quadlet file names the image, so it follows the current release
        write_quadlet(conf, version_of(current_release(conf)))
        systemctl('restart', PODMAN_UNIT)
    else:
        compose(conf, 'up', '-d', '--remove-orphans')
        compose(conf, 'restart')


def run_init(conf, release, env):
    """Prepare the state for a release (first run, migrations); returns what
    it printed, which on a new install includes the admin password."""
    if conf['mode'] == 'native':
        cmd = ['runuser', '-u', conf['user'], '--', 'env', f'EZY_STATE={conf["state"]}',
               *[f'{k}={v}' for k, v in env.items() if v is not None],
               str(Path(release) / '.venv/bin/python'), 'docker/init.py']
        return run(cmd, capture=True, cwd=str(release)).stdout
    if conf['mode'] == 'podman':
        return podman_run(conf, version_of(release), 'init', env=env).stdout
    args = ['run', '--rm', '--no-deps']
    for k, v in env.items():
        if v is not None:
            args += ['-e', f'{k}={v}']
    return compose(conf, *args, 'ezyspeech', 'init', release=release, capture=True).stdout


