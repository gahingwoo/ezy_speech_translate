    s.add_argument('--stdin', action='store_true', help='read it from standard input')
    s.add_argument('--json', action='store_true'); s.set_defaults(func=cmd_password)
    s = sub.add_parser('backup'); s.add_argument('file', nargs='?'); s.set_defaults(func=cmd_backup)
